# Tailscale auth key. Generate a reusable, ephemeral=false key in the tailnet
# admin console (Settings -> Keys). Never commit the real value.
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx

# Be honest about who is calling and give a way to be contacted. uhs-hints.com
# has been dormant since ~2015 and deserves a polite visitor.
USER_AGENT=OmniUHS/1.0 (+personal use; you@example.com)

# Upstream hostname allowlist. This is the SSRF boundary — only add hosts you
# actually intend to fetch from.
UPSTREAM_ALLOWLIST=uhs-hints.com,www.uhs-hints.com,strategywiki.org,www.strategywiki.org,ifdb.org,ifarchive.org,www.ifarchive.org

# Fandom / wiki.gg wikis to allow at startup.
#
# You do not need this: wikis are normally added from the app — search for a
# game, tap "Look for a wiki", tap Add — and they are stored in the cache
# database, live immediately, and removable the same way. This is for seeding a
# fresh container with wikis you always want.
#
# Anything listed here is *pinned*: the app will show it but refuse to remove
# it, on the grounds that something in the environment was put there on purpose.
# Only *.fandom.com and *.wiki.gg are accepted, here or from the app. Each wiki
# is asked for its own licence on first contact, and a -NC one marks everything
# from it personal-use-only.
# e.g. WIKI_ALLOWLIST=animalwell.wiki.gg,blue-prince.fandom.com
WIKI_ALLOWLIST=

# How much the proxy writes to `docker logs`. `info` is one line per request
# plus every upstream fetch, catalog refresh and search; `debug` adds cache
# hits and misses. Set LOG_REQUESTS=false to drop the per-request access line
# and keep only the activity events. The health check is never logged.
LOG_LEVEL=info
LOG_REQUESTS=true

# Sources a search hits when the request names none. StrategyWiki is left out
# because Cloudflare's managed challenge blocks server-side requests to it; the
# app retries those from your browser instead, and the chip is still there to
# turn on. Add `fandom,wikigg` to have wiki results appear in every search
# without switching the chips on; with no wikis added they cost nothing, since
# there is nothing to query.
SEARCH_SOURCES=uhs,ifarchive,ifdb
