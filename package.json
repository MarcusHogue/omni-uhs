{
  "name": "omni-uhs",
  "private": true,
  "version": "1.0.0",
  "description": "Personal-use, spoiler-safe game hint reader (UHS + open hint sources)",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "web",
    "proxy"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:tracked": "bash scripts/check-tracked.sh",
    "dev": "npm run dev --workspace web",
    "dump": "npm run dump --workspace web --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.8.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0"
  }
}
